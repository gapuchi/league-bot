# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# football-data.org API token from https://www.football-data.org/client/register
# Only needed for soccer leagues (World Cup, Premier League); the bot boots without it.
FOOTBALL_DATA_API_TOKEN=

# SQLite database path (optional; default: league_bot.db)
# DATABASE_PATH=league_bot.db
